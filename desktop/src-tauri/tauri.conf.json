{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Esmeringhoy",
  "version": "1.0.4",
  "identifier": "dev.esmeringhoy.desktop",
  "mainBinaryName": "Esmeringhoy",
  "build": {
    "frontendDist": "../../public",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Esmeringhoy",
        "width": 1180,
        "height": 740,
        "minWidth": 940,
        "minHeight": 600,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "noRedirectionBitmap": true,
        "shadow": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://i.ytimg.com https://*.ytimg.com https://yt3.ggpht.com https://*.googleusercontent.com; media-src 'self' https://esmeringhoy.pages.dev http://127.0.0.1:8788; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://esmeringhoy.pages.dev http://127.0.0.1:8788; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/Square107x107Logo.png",
      "icons/Square142x142Logo.png",
      "icons/Square150x150Logo.png",
      "icons/Square284x284Logo.png",
      "icons/Square30x30Logo.png",
      "icons/Square310x310Logo.png",
      "icons/Square44x44Logo.png",
      "icons/Square71x71Logo.png",
      "icons/Square89x89Logo.png",
      "icons/StoreLogo.png"
    ],
    "publisher": "Esmeringhoy",
    "copyright": "Copyright © Esmeringhoy",
    "category": "Music",
    "shortDescription": "Standalone Windows music player",
    "longDescription": "Esmeringhoy is a standalone Windows desktop music player with a Rust audio engine and a native WebView interface.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Esmeringhoy",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
